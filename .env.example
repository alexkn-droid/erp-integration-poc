# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. NEVER paste these values into chat with an AI assistant.

# --- Obtained from the Intuit Developer app dashboard (Keys & Credentials) ---
QBO_CLIENT_ID=placeholder-client-id
QBO_CLIENT_SECRET=placeholder-client-secret

# "sandbox" or "production". This POC must only ever be pointed at "sandbox".
QBO_ENVIRONMENT=sandbox

# The Company (realm) ID of the sandbox company you connected during the
# OAuth consent step. Printed by scripts/initial_oauth_exchange.py.
QBO_REALM_ID=placeholder-realm-id

# Must exactly match a Redirect URI registered on the app in the Intuit
# Developer dashboard. For local testing, e.g. http://localhost:8000/callback
QBO_REDIRECT_URI=http://localhost:8000/callback

# Local, gitignored file where OAuth access/refresh tokens are cached.
# In production this must be a secrets manager, not a flat file.
QBO_TOKEN_STORE_PATH=.state/tokens.json

# Local, gitignored files for the idempotency map and append-only audit log.
IDEMPOTENCY_STORE_PATH=.state/idempotency_store.json
AUDIT_LOG_PATH=.state/audit.log

# Retry tuning
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=1.0
